{
  "name": "taskflow-pro",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace @taskflow/api run dev",
    "dev:web": "npm --workspace @taskflow/web run dev",
    "build": "npm run build --workspace @taskflow/api && npm run build --workspace @taskflow/web",
    "test": "npm test --workspace @taskflow/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  }
}
